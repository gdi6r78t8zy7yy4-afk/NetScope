# NetScope Environment Configuration
# WARNING: Copy this file to .env and fill in real values before production!

# SECURITY CRITICAL - DO NOT USE DEFAULT VALUES
SECRET_KEY=placeholder-secret-key-not-for-production-use
API_KEY=placeholder-api-key-not-for-production-use

# Database Configuration
POSTGRES_USER=netscope
POSTGRES_PASSWORD=placeholder-postgres-password-not-for-production-use
POSTGRES_DB=netscope

# Application Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
DEBUG=false

# NVD API Configuration (optional - for vulnerability data)
NVD_API_KEY=

# CISA API Configuration
CISA_API_KEY=
