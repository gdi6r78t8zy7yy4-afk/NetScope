# NetScope Environment Configuration

# SECURITY CRITICAL - DO NOT commit the actual .env file to version control!

# Generate a secure SECRET_KEY using: openssl rand -hex 32
SECRET_KEY=generate-secure-secret-key-here-for-production

# Generate a secure API_KEY using: openssl rand -hex 16
API_KEY=generate-secure-api-key-here-for-production

# Database Configuration
POSTGRES_USER=netscope
POSTGRES_PASSWORD=secure-database-password-change-me

# Application Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
DEBUG=false

# NVD API Configuration (optional)
NVD_API_KEY=
