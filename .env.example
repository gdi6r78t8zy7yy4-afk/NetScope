# NetScope Environment Configuration Example

# SECURITY CRITICAL - Copy this file to .env and fill in real values!
# DO NOT commit the actual .env file to version control!

# Generate a secure SECRET_KEY using: openssl rand -hex 32
SECRET_KEY=your-super-secret-32-character-key-here

# Generate a secure API_KEY using: openssl rand -hex 16
API_KEY=your-secure-api-key-here

# Database Configuration
POSTGRES_USER=netscope
POSTGRES_PASSWORD=secure-database-password-change-me

# Application Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
DEBUG=false

# NVD API Configuration (optional)
NVD_API_KEY=
