# NetScope Backend Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME="NetScope"
DEBUG=false

# Backend Server
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Database (default is SQLite for development)
DATABASE_URL="sqlite+aiosqlite:///./data/netscope.db"

# SECURITY - REQUIRED for production
# Generate a secure key: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secure-secret-key-here

# Token settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scanning
DEFAULT_RATE_LIMIT=medium
MAX_CONCURRENT_HOSTS=5
SCAN_TIMEOUT_SECONDS=3600

# Intelligence Sources (optional)
CISA_API_KEY=
NVD_API_KEY=
INTELLIGENCE_UPDATE_INTERVAL_HOURS=24

# Dependencies
NMAP_REQUIRED=true
ARP_SCAN_REQUIRED=false
TSHARK_OPTIONAL=true
