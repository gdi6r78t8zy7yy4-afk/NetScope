# NetScope Environment Variables Example

# Copy this file to .env and fill in the values for your environment

# Application
APP_NAME="NetScope"
APP_VERSION="1.0.0"
DEBUG=false

# Security - REQUIRED
SECRET_KEY=your-secure-secret-key-here-change-in-production
API_KEY=your-api-key-here

# Database - PostgreSQL for production
DATABASE_URL=postgresql+asyncpg://netscope:netscope123@localhost:5432/netscope

# Redis (optional, for caching and rate limiting in production)
REDIS_URL=redis://localhost:6379/0

# API Keys
CISA_API_KEY=your-cisa-api-key-here
NVD_API_KEY=your-nvd-api-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7
